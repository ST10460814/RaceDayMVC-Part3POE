@model List<System.Text.Json.JsonElement>
@using System.Text.Json

@{
    ViewData["Title"] = "My Registrations";
}

<div class="container mt-4">
    <h2>My Event Registrations</h2>
    <p class="text-muted">
        View and manage your RaceDay event enrolments.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You haven't registered for any events yet.
        </div>

        <a asp-controller="Event"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Registration ID</th>
                            <th>Event ID</th>
                            <th>Date Registered</th>
                            <th>Status</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var id = item.GetProperty(
                            "registrationId").GetInt32();

                            var eventId = item.GetProperty(
                            "eventId").GetInt32();

                            var date = item.GetProperty(
                            "registrationDate").GetDateTime();

                            var status = item.GetProperty(
                            "registrationStatus").GetString();

                            var payment = item.GetProperty(
                            "paymentStatus").GetString();

                            <tr>
                                <td>@id</td>
                                <td>@eventId</td>
                                <td>@date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-success">
                                        @status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @payment
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <a asp-controller="Event"
           asp-action="Index"
           class="btn btn-primary mt-3">
            Browse More Events
        </a>
    }
</div>
