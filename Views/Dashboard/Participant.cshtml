@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">
    <h1>Participant Dashboard</h1>
    <p>Discover and participate in RaceDay events.</p>

    <div class="row mt-4">

        <!-- Browse Events -->
        <div class="col-md-4 mb-3">
            <a asp-controller="Event"
               asp-action="Index"
               class="text-decoration-none text-dark">

                <div class="card shadow p-4 h-100">
                    <h4>Browse Events</h4>
                    <p>
                        Find upcoming running, walking
                        and cycling events.
                    </p>
                    <span class="text-primary">
                        Browse Events →
                    </span>
                </div>
            </a>
        </div>

        <!-- My Registrations -->
        <div class="col-md-4 mb-3">
            <a asp-controller="Registration"
               asp-action="Mine"
               class="text-decoration-none text-dark">

                <div class="card shadow p-4 h-100">
                    <h4>My Registrations</h4>
                    <p>View your event enrolments.</p>
                    <span class="text-primary">
                        View Registrations →
                    </span>
                </div>
            </a>
        </div>

        <!-- My Results -->
        <div class="col-md-4 mb-3">
            <a asp-controller="Result"
               asp-action="Mine"
               class="text-decoration-none text-dark">

                <div class="card shadow p-4 h-100">
                    <h4>My Results</h4>
                    <p>View your race performances.</p>
                    <span class="text-primary">
                        View Results →
                    </span>
                </div>
            </a>
        </div>

    </div>
</div>
