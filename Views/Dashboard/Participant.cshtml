@{
}

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">
    <h1>Participant Dashboard</h1>
    <p>Discover and participate in RaceDay events.</p>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>Browse Events</h4>
                <p>
                    Find upcoming running, walking
                    and cycling events.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>My Registrations</h4>
                <p>View your event enrolments.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>My Results</h4>
                <p>View your race performances.</p>
            </div>
        </div>
    </div>
</div>
