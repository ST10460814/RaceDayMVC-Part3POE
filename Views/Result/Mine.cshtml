@model List<System.Text.Json.JsonElement>
@using System.Text.Json

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>
    <p class="text-muted">
        View your race performances and finishing positions.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race results have been recorded for you yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <pre>@JsonSerializer.Serialize(
                                            Model,
                                            new JsonSerializerOptions
                                            {
                                                    WriteIndented = true
                                            })</pre>
        </div>
    </div>
        }

    <a asp-controller="Dashboard"
       asp-action="Participant"
       class="btn btn-primary mt-3">
        Back to Dashboard
    </a>
</div>
