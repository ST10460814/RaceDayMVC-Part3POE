@{
}

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h1>Organiser Dashboard</h1>
    <p>Manage your RaceDay events and participants.</p>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>Events</h4>
                <p>Create and manage race events.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>Registrations</h4>
                <p>View participant enrolments.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-4">
                <h4>Results</h4>
                <p>Capture race results.</p>
            </div>
        </div>
    </div>
</div>
